# Copy to config.env and fill in. config.env is never committed.
# Get the key at https://fatebook.io/api-setup (sign in first).
FATEBOOK_API_KEY=
# Your Fatebook user id: the "userId" on any question you created in the API output.
FATEBOOK_USER_ID=
# "yes" also publishes questions shared by link only (not on fatebook.io/public).
INCLUDE_UNLISTED=no
